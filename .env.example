# Supabase credentials.
#
# Copy this file to .env.local and fill in the values from your Supabase project:
# Project Settings -> API -> Project URL and anon public key.
#
# Both are required. Without them the app falls back to placeholder values,
# isSupabaseConfigured() returns false, and every data call returns empty
# instead of failing loudly.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
